{
  "__comment": "Deliberately small starter dashboard. Serving-layer metric names follow vLLM's convention (a `vllm:` prefix), which NIM adopts; NIM versions differ slightly, so if a panel is empty, `curl your-nim:8000/metrics | grep -i token` and adjust the names — that exploration is worth doing once regardless. Same recipe for the gateway panels: `curl -L gateway:4000/metrics/ | grep litellm_` (note: /metrics 307-redirects to /metrics/, so use -L; Prometheus follows it automatically). Both metric NAMES and LABEL names vary across LiteLLM versions — as of v1.83.x the per-model label on the proxy metrics is `requested_model` (not `model`), which is what panels 5–6 group by. Richer community dashboards for vLLM/NIM and DCGM can be imported from grafana.com and are linked in docs/06-monitoring.md.",
  "title": "LLM Service — Overview",
  "uid": "llm-overview",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests running / waiting (per backend)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "vllm:num_requests_running", "legendFormat": "{{model}} running" },
        { "expr": "vllm:num_requests_waiting", "legendFormat": "{{model}} queued" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Time to first token, p50 / p95 (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Generation throughput (tokens/s)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(vllm:generation_tokens_total[5m])", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "GPU utilization & memory (DCGM)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "gpu{{gpu}} util %" },
        { "expr": "DCGM_FI_DEV_FB_USED / 1024", "legendFormat": "gpu{{gpu}} mem GiB" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Gateway: requests/s by model (LiteLLM)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (requested_model) (rate(litellm_proxy_total_requests_metric_total[5m]))", "legendFormat": "{{requested_model}}" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Gateway: request failures/s (LiteLLM)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (requested_model) (rate(litellm_proxy_failed_requests_metric_total[5m]))", "legendFormat": "{{requested_model}} failed" }
      ]
    }
  ]
}
