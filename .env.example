# ─── Copy to .env and fill in. Never commit .env. ──────────────────────────

# Your personal/service API key from https://build.nvidia.com (free tier is fine
# for the pilot). This is the *upstream* credential the gateway uses; your
# users never see it — they get their own keys minted by the gateway.
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Admin ("master") key for the gateway. Anyone holding this can mint user keys
# and read spend data. Generate with:  openssl rand -hex 24
# Must start with "sk-".
LITELLM_MASTER_KEY=sk-REPLACE_ME

# Password for the gateway's Postgres database (stores keys, users, spend logs).
# Generate with:  openssl rand -hex 16
POSTGRES_PASSWORD=REPLACE_ME

# ─── TLS front door (make tls) — set before handing out keys ────────────────
# Hostnames for the HTTPS endpoints; DNS for both must point at this machine.
# Users then get https://$GATEWAY_HOSTNAME/v1 and https://$WEBUI_HOSTNAME —
# never the plain-HTTP ports. See docs/00-02-getting-started.md step 4.
GATEWAY_HOSTNAME=llm.example.edu
WEBUI_HOSTNAME=chat.llm.example.edu

# ─── Phase 1 (self-hosted NIM) only ─────────────────────────────────────────
# NGC API key for pulling NIM containers, from https://ngc.nvidia.com
# (often the same value as NVIDIA_API_KEY; both work for nvcr.io pulls).
NGC_API_KEY=nvapi-REPLACE_ME

# ─── Optional: UI admin bootstrap ───────────────────────────────────────────
# Open WebUI: the first account created via the web page becomes admin.
